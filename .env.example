# 该配置文件的后缀改成对应的运行环境名(dev/prod)

APP_ENV=                    # 测试环境dev/生产环境prod

LLM_PROVIDER=               # LLM 提供方，例如 openai / deepseek / ollama / azure
API_KEY=                    # API Key（云端模型需要，本地模型可为空）
BASE_URL=                   # API Base URL，例如 https://api.xxx.com/v1
MODEL_NAME=                 # 模型名称，例如 gpt-4o / deepseek-chat / llama3

LLM_TEMPERATURE=            # TEMPERATURE，例如 0.3 / 0.7 / 1.0
LLM_MAX_TOKENS=             # 最大输出 token 数，例如 512 / 1024 / 2048